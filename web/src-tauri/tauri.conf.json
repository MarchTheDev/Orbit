{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Orbit",
  "version": "1.0.1",
  "identifier": "com.orbit.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Orbit",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": null,
        "dragDropEnabled": true,
        "backgroundColor": "#0b0a16",
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/orbit-x11": "../../packaging/linux/orbit-x11",
          "/usr/share/applications/orbit-x11.desktop": "../../packaging/linux/orbit-x11.desktop"
        }
      },
      "rpm": {
        "files": {
          "/usr/bin/orbit-x11": "../../packaging/linux/orbit-x11",
          "/usr/share/applications/orbit-x11.desktop": "../../packaging/linux/orbit-x11.desktop"
        }
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}

{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Orbit",
  "version": "1.1.0",
  "identifier": "com.orbit.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "Orbit",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": null,
        "dragDropEnabled": true,
        "backgroundColor": "#0b0a16",
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-pipewire"
        ],
        "files": {
          "/usr/bin/orbit-x11": "../../packaging/linux/orbit-x11",
          "/usr/share/applications/orbit-x11.desktop": "../../packaging/linux/orbit-x11.desktop",
          "/usr/share/applications/com.orbit.launcher.desktop": "../../packaging/linux/com.orbit.launcher.desktop",
          "/usr/share/icons/hicolor/128x128/apps/com.orbit.launcher.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/128x128/apps/orbit.png": "icons/128x128.png",
          "/usr/lib/udev/rules.d/60-orbit-controllers.rules": "../../packaging/linux/60-orbit-controllers.rules"
        }
      },
      "rpm": {
        "depends": [
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "pipewire-gstreamer"
        ],
        "files": {
          "/usr/bin/orbit-x11": "../../packaging/linux/orbit-x11",
          "/usr/share/applications/orbit-x11.desktop": "../../packaging/linux/orbit-x11.desktop",
          "/usr/share/applications/com.orbit.launcher.desktop": "../../packaging/linux/com.orbit.launcher.desktop",
          "/usr/share/icons/hicolor/128x128/apps/com.orbit.launcher.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/128x128/apps/orbit.png": "icons/128x128.png",
          "/usr/lib/udev/rules.d/60-orbit-controllers.rules": "../../packaging/linux/60-orbit-controllers.rules"
        }
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "nsis/installer.ico",
        "uninstallerIcon": "nsis/installer.ico",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}

[Desktop Entry]
Type=Application
Name=Orbit
Comment=A library for the games on your PC: launches them, times them, and shows where the disk space went
Exec=orbit
# Waybar and other Wayland panels look the window up by the app id, which is
# com.orbit.launcher, not by the binary name. This entry exists so that lookup
# finds an icon. It is hidden from the menu: the ordinary entry is the one a
# person launches.
NoDisplay=true
Icon=com.orbit.launcher
Terminal=false
Categories=Game;Utility;
StartupWMClass=com.orbit.launcher

#!/bin/sh
# Orbit, forced onto X11.
#
# For the sessions where WebKitGTK's native Wayland rendering misbehaves: a
# window that never paints, input that lands in the wrong place, or a crash on
# startup that does not happen under X.
#
# GDK_BACKEND is read by GDK as it starts, so it has to be in the environment
# before the program runs rather than set from inside it. That is the whole
# difference between this and `orbit`: the binary is the same one, and a
# session that already works should keep using it.
#
# Worth knowing before you reach for it:
#
#   * On a Wayland session this draws through XWayland, which does not do
#     fractional scaling. On a high-density screen the window can look soft.
#   * A blank window can have several causes. Start Orbit from a terminal and
#     inspect its logs before changing WebKit renderer settings.
#   * If it is only the overlay that flashes up and vanishes on Wayland with
#     the proprietary NVIDIA driver, it does not need this wrapper at all:
#     Orbit restarts itself through X11 on that stack (XWayland keeps an
#     RGBA window alive where the native Wayland surface is dropped), unless
#     ORBIT_X11=0 said not to. For a solid panel instead of that dance,
#     ORBIT_OVERLAY_TRANSPARENT=0 orbit gives the window a ground it cannot
#     vanish from (the transparent surface is the default).
#
# Arguments are passed through, so `orbit-x11 --whatever` behaves as `orbit
# --whatever` would.
exec env GDK_BACKEND=x11 orbit "$@"
